# AI APIs
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Delivery (iCloud or App Password for SMTP)
ICLOUD_APP_PASSWORD=your_icloud_app_password_here

# LLM Rate Limiting
LLM_MAX_CONCURRENT=3

# Database configuration (Auto-resolved inside container)
SQLITE_DB_PATH=/app/quant_system.db
