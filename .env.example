# AI APIs
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Delivery (provider-neutral SMTP credentials)
SMTP_USERNAME=your_smtp_login_email_here
SMTP_APP_PASSWORD=your_smtp_authorization_code_here

# Legacy iCloud compatibility; prefer SMTP_APP_PASSWORD for new setups.
ICLOUD_APP_PASSWORD=your_icloud_app_password_here

# LLM Rate Limiting
LLM_MAX_CONCURRENT=3

# Database configuration (Auto-resolved inside container)
SQLITE_DB_PATH=/app/quant_system.db

# Official US financial filings (identify the application and a monitored contact)
SEC_USER_AGENT=Global-Macro-Radar contact@example.com

# US/HK source health. The legacy US_HK_MIN_DATA_COVERAGE remains supported,
# but MIN_TRANSPORT_COVERAGE is the unambiguous name.
US_HK_MIN_TRANSPORT_COVERAGE=0.80

# Financial usability/conflict gates are calibrated from the completed
# 2026-07-27 full-universe audit. Market-specific values override these
# built-in defaults when a later audited baseline justifies a change.
US_HK_US_MIN_FINANCIAL_USABLE_COVERAGE=0.80
US_HK_HK_MIN_FINANCIAL_USABLE_COVERAGE=0.45
US_HK_US_MAX_FINANCIAL_CONFLICT_RATE=0.10
US_HK_HK_MAX_FINANCIAL_CONFLICT_RATE=0.10

# The stage budget scales with universe size. These are per-worker-batch
# budgets; US_HK_STAGE_TIMEOUT_SECONDS is retained as the absolute floor.
US_HK_US_SECONDS_PER_TICKER_BUDGET=15
US_HK_HK_SECONDS_PER_TICKER_BUDGET=120
